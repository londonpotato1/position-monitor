# Position Monitor — read-only API keys for monitoring.
# Copy this file to `.env` and fill in your read-only API keys.
# Trade permissions are NOT required (this app does not place orders).
#
# Variable naming: keys must end with _API_KEY / _API_SECRET (matches code).
# If you set a shorter form (e.g. BINANCE_SECRET), it auto-aliases to
# BINANCE_API_SECRET for backward compatibility — but the _KEY side has
# NO alias, so always use _API_KEY explicitly.

# ── Korean exchanges ──────────────────────────────
UPBIT_API_KEY=
UPBIT_API_SECRET=

BITHUMB_API_KEY=
BITHUMB_API_SECRET=

# ── Major overseas (centralized) ──────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

GATE_API_KEY=
GATE_API_SECRET=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

MEXC_API_KEY=
MEXC_API_SECRET=

HTX_API_KEY=
HTX_API_SECRET=

# ── DEX (special key formats) ─────────────────────
# Hyperliquid: wallet address + private key (0x-prefixed)
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# Lighter: account index (integer) + private key + api key index
LIGHTER_ACCOUNT_INDEX=
LIGHTER_PRIVATE_KEY=
LIGHTER_API_KEY_INDEX=
