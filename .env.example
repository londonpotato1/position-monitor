# Position Monitor — read-only API keys for monitoring.
# Copy this file to `.env` and fill in your read-only API keys.
# Trade permissions are NOT required (this app does not place orders).

# Korean exchanges
UPBIT_KEY=
UPBIT_SECRET=

BITHUMB_KEY=
BITHUMB_SECRET=

# Major overseas
BINANCE_KEY=
BINANCE_SECRET=
# (alias auto-applied: BINANCE_API_SECRET)

BYBIT_KEY=
BYBIT_SECRET=
# (alias: BYBIT_API_SECRET)

OKX_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
# (alias: OKX_API_SECRET)

GATE_KEY=
GATE_API_SECRET=
# (alias: GATE_SECRET)

BITGET_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=

KUCOIN_KEY=
KUCOIN_SECRET=
KUCOIN_PASSPHRASE=

MEXC_KEY=
MEXC_SECRET=

HTX_KEY=
HTX_SECRET=
# (alias: HTX_API_SECRET)

# DEX
HYPERLIQUID_API_KEY=
HYPERLIQUID_SECRET=
# (aliases: HYPERLIQUID_WALLET_ADDRESS, HYPERLIQUID_PRIVATE_KEY)

LIGHTER_API_KEY=
LIGHTER_SECRET=
# (alias: LIGHTER_PRIVATE_KEY)
